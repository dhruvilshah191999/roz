# Postgres connection string.
# Local (docker compose up -d):
DATABASE_URL=postgres://roz:roz@localhost:5433/roz
# Production (Neon): paste the pooled connection string from the Neon dashboard.

# Any long random string. Mixed with the date to seed each day's puzzles so
# nobody can compute tomorrow's puzzle from the client bundle.
DAILY_SEED_SECRET=change-me-to-a-long-random-string

# Public URL used in the share text. Optional.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
